{
  "$comment": "Hand-recorded route map for Indus, captured from a live scan session on 2026-08-11. Coordinates are normalised (0-1) against a landscape screen, so they survive a change of device resolution. The agent uses this to skip the guessing phase: it can drive straight to known screens, switch language, and recover from a stuck state instead of rediscovering all of it by vision.",
  "app": {
    "name": "Indus",
    "packages": {
      "dev": "com.indusgame.dev",
      "staging": "com.indusgame.staging",
      "prod": "com.indusgame.play"
    },
    "engine": "unity",
    "orientation": "landscape",
    "recordedOn": {
      "device": "vivo I2217",
      "resolution": [
        2400,
        1080
      ],
      "build": "1.12.0 #11424000"
    }
  },
  "capabilities": {
    "accessibilityText": false,
    "$comment": "uiautomator dump returns zero text nodes — Unity draws into a single SurfaceView. Every string must be read from pixels. True for dev, staging and prod alike, so no build variant gives a shortcut.",
    "bridge": false
  },
  "recovery": {
    "$comment": "EC-70001 'LOST CONNECTION' can strand the app on a modal that RETRY does not clear. A force-stop and relaunch reliably recovers it; observed once on dev.",
    "detect": {
      "anyText": [
        "LOST CONNECTION",
        "EC-70001"
      ]
    },
    "steps": [
      {
        "action": "shell",
        "cmd": "am force-stop {package}"
      },
      {
        "action": "wait",
        "ms": 2000
      },
      {
        "action": "launch",
        "package": "{package}"
      },
      {
        "action": "wait",
        "ms": 30000
      }
    ]
  },
