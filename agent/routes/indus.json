  "procedures": {
    "setLanguage": {
      "$comment": "Language is per account, not per device locale — the device stays on India/en. Takes about 10s to apply and returns to the lobby.",
      "from": "lobby",
      "steps": [
        {
          "tap": "lobby.settingsGear",
          "wait": 3000
        },
        {
          "tap": "settings.general.tabAccount",
          "wait": 2000
        },
        {
          "tap": "settings.account.languageChange",
          "wait": 3000
        },
        {
          "tap": "settings.languagePicker.{language}",
          "wait": 1000
        },
        {
          "tap": "settings.languagePicker.confirm",
          "wait": 12000
        }
      ]
    }
  },
  "knownIssues": {
    "$comment": "Do not report these as findings; they are known and accepted for this build.",
    "arabic": "Arabic is not fully implemented in 1.12.0 — the whole UI renders as tofu boxes because the glyph atlas is missing. Skip Arabic entirely on this build.",
    "launchPromo": "A promotional interstitial may cover the lobby after launch. Close it via screens.promoInterstitial.close before driving any lobby coordinates."
  }
