{
  "name": "localinter-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "LocaLinter as one Windows app \u2014 the UI and the device-scan agent in a single process.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.supergaming.localinter",
    "productName": "LocaLinter",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "app",
        "filter": [
          "index.html",
          "styles.css",
          "main.js",
          "shell.js",
          "device-scan.js",
          "device-scan.css",
          "assets/**/*",
          "agent/**/*",
          "!agent/config.json",
          "!agent/auth.json",
          "!agent/memory/**",
          "!agent/runs/**",
          "!agent/dist/**",
          "!agent/build/**",
          "!agent/tools/**",
          "!agent/build.js",
          "!agent/.gitignore"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": null
  }
}
